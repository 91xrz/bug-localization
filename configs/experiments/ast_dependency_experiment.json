{
  "base_config": "configs/retrieval/bm25.json",
  "selection_manifest": null,
  "repositories": [
    "psf/requests"
  ],
  "limit": 44,
  "model_path": "models/Qwen3-Embedding-0.6B",
  "max_tokens": 512,
  "prefix_max_tokens": 96,
  "embedding_batch_size": 64,
  "device": "cuda",
  "gpu_count": 2,
  "chunk_workers": 8,
  "chunk_prefetch": true,
  "query_instruction": "Given a bug report, retrieve source code that contains the bug and needs to be modified to fix it.",
  "dynamic_general_cost": 50,
  "dynamic_max_lines": 30,
  "fixed_chunk_tokens": 400,
  "chunking_routes": [
    "blagent_ast",
    "ast_dependency"
  ],
  "ast_max_chars": 1500,
  "language_overrides": {},
  "enable_fusion": false,
  "file_aggregation": "max",
  "aggregation_temperature": 0.1,
  "evaluation_k": 10,
  "rrf_constant": 60,
  "dependency_max_functions": 2,
  "dependency_max_tokens": 128,
  "dependency_function_max_tokens": 64,
  "dependency_field_max_tokens": 24,
  "dependency_max_fields": 3
}
